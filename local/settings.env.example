# Copied to local/settings.env by up.sh, which git ignores. Change only what you need.

# Names the compose project, its containers and its volumes.
COMPOSE_PROJECT_NAME=seamless-oidc-local

# The hosted pages are served from auth.<APP_NAME>.localhost, and passkeys are bound to
# <APP_NAME>.localhost, so this is one label: lower case letters, digits and hyphens.
APP_NAME=myapp

# Host ports, all on 127.0.0.1 only. The issuer contains the TLS port, so changing it after the
# first run needs ./down.sh --wipe.
TLS_PORT=9443
API_PORT=9312
MAILBOX_PORT=9025

# Images. Postgres has no host port: only the API reaches it.
SEAMLESS_EDGE_IMAGE=ghcr.io/fells-code/seamless-auth-oidc-provider:v0.4.1
SEAMLESS_API_IMAGE=ghcr.io/fells-code/seamless-auth-api:v0.23.0
POSTGRES_IMAGE=postgres:18-alpine
CADDY_IMAGE=caddy:2.10-alpine
NODE_IMAGE=node:24-alpine
