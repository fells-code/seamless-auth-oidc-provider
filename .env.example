# The private Seamless Auth API, as this service reaches it.
SEAMLESS_API_URL=http://localhost:5312
# The API's ISSUER, when it differs from SEAMLESS_API_URL.
# SEAMLESS_API_ISSUER=http://auth:5312
# The service token secret shared with the API (SEAMLESS_SERVICE_TOKEN there).
SEAMLESS_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# SEAMLESS_JWKS_KID=dev-main
# Signs the first-party session cookies the hosted pages use.
SEAMLESS_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Comma separated. The first key signs provider cookies; the rest still verify, for rotation.
OIDC_COOKIE_KEYS=replace-with-at-least-32-random-characters
# Set to true when TLS ends at a proxy in front of this service.
TRUST_PROXY=false
PORT=5314
